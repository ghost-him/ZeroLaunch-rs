<?xml version="1.0" encoding="utf-8" ?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!--
    ZeroLaunch - 批量签名所有构建产物

    支持的文件类型：
    1. Inno Setup 安装包 (*-setup.exe) - Authenticode 签名
    2. 便携版 ZIP 包 (.zip) - 深度签名内部可执行文件，再 JAR 签名 ZIP
    3. 命令行工具 (zerolaunch-cli_*.exe) - Authenticode 签名
  -->

  <zip-file>
    <!-- 1. Inno Setup 安装包 -->
    <pe-file path="ZeroLaunch-*-setup.exe" max-matches="unbounded" min-matches="1">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>

    <!-- 2. 便携版 ZIP：先签内部 exe，再签 ZIP 本身 -->
    <zip-file path="ZeroLaunch-portable*-*.zip" max-matches="unbounded" min-matches="0">
      <pe-file path="ZeroLaunch_*.exe" max-matches="unbounded" min-matches="0">
        <authenticode-sign hash-algorithm="sha256" />
      </pe-file>
      <jar-sign />
    </zip-file>

    <!-- 3. CLI 命令行工具 -->
    <pe-file path="zerolaunch-cli_*.exe" max-matches="unbounded" min-matches="0">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
